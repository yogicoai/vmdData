# ── MongoDB ──
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=vmdData

# ── FTP (yogibo.openhost / Cafe24 오픈호스팅) 이미지 업로드 ──
FTP_HOST=yogibo.openhost...
FTP_PORT=21
FTP_USER=
FTP_PASSWORD=
FTP_SECURE=false
# 이미지를 올릴 FTP 상의 디렉터리 (이 호스팅은 FTP 루트 = 웹 루트)
FTP_UPLOAD_DIR=/web/img/vmd
# 도메인 베이스만 (공개 URL = FTP_PUBLIC_BASE + FTP_UPLOAD_DIR + 파일명)
FTP_PUBLIC_BASE=https://yogibo.openhost.cafe24.com/

# ── 인증 (마지막 단계에서 사용) ──
SESSION_SECRET=change-me-to-a-long-random-string
