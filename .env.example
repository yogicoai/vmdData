# ── MongoDB ──
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=vmdData

# ── FTP (yogibo.openhost / Cafe24 오픈호스팅) 이미지 업로드 ──
FTP_HOST=yogibo.openhost...
FTP_PORT=21
FTP_USER=
FTP_PASSWORD=
FTP_SECURE=false
# 이미지를 올릴 FTP 상의 디렉터리 (웹 루트 기준 경로)
FTP_UPLOAD_DIR=/vmd/images
# 위 디렉터리에 대응하는 공개 URL 베이스 (끝 슬래시 없이)
PUBLIC_IMAGE_BASE=http://yogibo.openhost.../vmd/images

# ── 인증 (마지막 단계에서 사용) ──
SESSION_SECRET=change-me-to-a-long-random-string
